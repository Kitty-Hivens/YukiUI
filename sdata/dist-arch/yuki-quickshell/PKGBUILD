# Builds Quickshell from our fork instead of using the repo package, because the fork
# carries the polkit agent registration fix: upstream registers the agent for the session
# resolved from its own cgroup, which does not exist for a process inside user@.service,
# so under a uwsm session the agent never registers and no password prompt can appear.
# See https://github.com/quickshell-mirror/quickshell/pull/875 -- once that merges, drop
# this build and go back to depending on the repo `quickshell`.
#
# Built from the fork's `yuki` branch, the fix put on top of a newer upstream, not from
# its master, which the pull request is opened from and is left as it is. The upstream
# under it has to be new enough to build against the Qt installed: Qt 6.12 refuses
# meta types that are only declared, which upstream stopped using in October 2026.
#
# The branch also keeps a tray menu's entries whole across a partial DBusMenu update.
# Upstream applies every ItemsPropertiesUpdated as the full set of properties and resets
# what it leaves out, so a program announcing a new toggle state alone, Easy Effects with
# its presets, had its checkmark entries drawn as plain ones after the first pick.
#
# And a process the shell starts goes with the shell. Upstream stops it only when the
# shell exits cleanly, so a shell that crashed or was killed left its helpers running
# for the rest of the session, a gamemode request among them, holding gamemode on.
#
# And a tray item is told where it was clicked, and asked for a context menu of its
# own: upstream sends every activation the top left corner of the screen and has no
# call for ContextMenu, so a program drawing its own tray menu, one under Wine through
# the tray bridge, could not be opened by a right click.
#
# And a live picture of a window that closes under it no longer takes the shell
# down. Hyprland makes no frame for a window already gone by the time the capture
# request arrives, and the shell's request to destroy that frame was a protocol
# error that ended its connection. A frame not answered yet is let go only once a
# roundtrip has shown whether it exists.

groups=(illogical-impulse)
_pkgname=quickshell
pkgname=yuki-quickshell
# epoch, because this supersedes the meta package that was versioned 1.0
epoch=1
pkgver=0.3.2
pkgrel=5
_commit='b046e88520845ce14bd53ccd361cf1fe52c8d850'
pkgdesc='Quickshell built from the fork carrying the polkit session, DBusMenu, child process, tray click and window capture fixes, plus extra Qt deps'
arch=(x86_64 aarch64)
url='https://github.com/Kitty-Hivens/quickshell'
license=('LGPL-3.0-only')
depends=(
  'cpptrace'
  'jemalloc'
  'mesa'
  'qt6-declarative'
  'qt6-base'
  'qt6-svg'
  'libdrm'
  'libpipewire'
  'libxcb'
  'wayland'
  # NOTE: Below are custom dependencies of illogical-impulse
  qt6-5compat
  qt6-avif-image-plugin
  qt6-imageformats
  qt6-multimedia
  qt6-positioning
  qt6-quicktimeline
  qt6-sensors
  qt6-svg
  qt6-tools
  qt6-translations
  qt6-virtualkeyboard
  qt6-wayland
  kirigami
  kdialog
  syntax-highlighting
)
makedepends=(
  'cli11'
  'cmake'
  'git'
  'ninja'
  'qt6-shadertools'
  'spirv-tools'
  'vulkan-headers'
  'wayland'
  'wayland-protocols'
)
# Called illogical-impulse-quickshell before YukiUI named its own packages.
provides=("$_pkgname" illogical-impulse-quickshell)
conflicts=("$_pkgname" "$_pkgname-git" illogical-impulse-quickshell)
replaces=(illogical-impulse-quickshell)

source=("$_pkgname::git+$url.git#commit=$_commit"
  quickshell-check.hook)
sha256sums=('SKIP'
  '8543e21aeaaa5441b73a679160e7601a957f16c433e8d6bd9257e80bd0e94083')

build() {
  cd "$_pkgname"
  cmake -GNinja -B build \
    -DCMAKE_BUILD_TYPE="RelWithDebInfo" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISTRIBUTOR="YukiUI (patched: polkit agent registration, dbusmenu partial updates, children die with the shell, tray click points, window capture)" \
    -DDISTRIBUTOR_DEBUGINFO_AVAILABLE=NO \
    -DINSTALL_QML_PREFIX=lib/qt6/qml

  # As many compilers at once as memory allows, not only as the cores do. Ninja
  # runs one more than there are threads, and with Qt's headers each takes up to
  # a gigabyte or two, so a laptop with twelve threads ran out of memory halfway
  # and took the terminal down with it. Two gigabytes of what is available per
  # job, at least one, at most one per thread. CMAKE_BUILD_PARALLEL_LEVEL, when
  # set, is taken as it is. Run under makepkg's errexit, hence ifs.
  local available jobs threads
  available=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
  threads=$(nproc)
  jobs=$(( available / (2 * 1024 * 1024) ))
  if (( jobs < 1 )); then jobs=1; fi
  if (( jobs > threads )); then jobs=$threads; fi
  cmake --build build -j "${CMAKE_BUILD_PARALLEL_LEVEL:-$jobs}"
}

package() {
  install -Dm644 "quickshell-check.hook" -t "$pkgdir/usr/share/libalpm/hooks"
  cd "$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$_pkgname"
}
