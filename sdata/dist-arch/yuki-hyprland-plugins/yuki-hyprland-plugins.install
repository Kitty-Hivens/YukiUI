post_install() {
    /usr/lib/yuki-hyprland-plugins/build
    echo "To give Bluetooth connections devices open the fast packets: systemctl enable --now yuki-btlinks"
}

post_upgrade() {
    /usr/lib/yuki-hyprland-plugins/build
    # A service running the build before goes on to the new one.
    systemctl try-restart yuki-btlinks.service 2>/dev/null
    true
}

# The built files belong to no package, since they are made on this machine.
post_remove() {
    rm -f /usr/lib/yuki-hyprland-plugins/*.so /usr/lib/yuki-hyprland-plugins/.*.so.new
    rmdir --ignore-fail-on-non-empty /usr/lib/yuki-hyprland-plugins 2>/dev/null
    rm -f /usr/lib/yuki/yuki-* /usr/lib/yuki/.yuki-*.new
    rmdir --ignore-fail-on-non-empty /usr/lib/yuki 2>/dev/null
    true
}
