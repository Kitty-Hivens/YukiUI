[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = hyprland

[Action]
Description = Rebuilding YukiUI Hyprland plugins for the new Hyprland...
When = PostTransaction
Depends = gcc
Depends = make
Depends = pkgconf
Depends = wayland-protocols
Exec = /usr/lib/yuki-hyprland-plugins/build
