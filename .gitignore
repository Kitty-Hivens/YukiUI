/diagnose.result
/cache

# Ignore Python cache files
__pycache__/
*.py[cod]

/dots/.config/quickshell/yuki/.qmlls.ini

# exp-update
/.update-lock

# Copies of the running configuration, kept by the experimental subcommands before
# they replace anything. They belong to whoever ran them and never to the history.
/.update-backups
/.exp-merge-backups

# custom os-release
/os-release

# Emacs auto backup file
*~

# Built plugins: tied to the Hyprland they were compiled against
/hypr-plugins/*/*.so

# The shell parts the tests run, written for a run and removed after it
/dots/.config/quickshell/yuki/bench*Probe.qml
