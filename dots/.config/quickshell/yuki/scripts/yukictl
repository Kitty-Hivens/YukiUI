#!/usr/bin/env bash
# Manage the shell's environments and plugins from a terminal.
#
# The registries live in the running shell -- they are what is on disk crossed
# with what the config allows -- so this asks the shell rather than reading the
# files a second time and disagreeing with it.
set -uo pipefail

# The name of the config this belongs to, taken from where the script lives: it
# sits one level under the shell root, and spelling the name out here would tie
# the script to a directory it does not control. The path is resolved first,
# because called through a symlink on PATH the source names the link, whose
# directory has nothing to do with the shell.
self="$(realpath "${BASH_SOURCE[0]}")"
config_name="$(basename "$(cd "$(dirname "$self")/.." && pwd)")"

usage() {
    cat <<EOF
usage: yukictl <command>

  plugins list                what is installed, what runs, what is wrong
  plugins enable <id>         build it from now on
  plugins disable <id>        take it down and leave it down

  env list                    installed environments and which one is up
  env use <id>                switch to it, turning it back on if it was off

An environment is a part of the shell and exactly one is up. A plugin adds to
whatever is already there and every one enabled is built.
EOF
}

call() {
    local out
    if ! out="$(qs -c "$config_name" ipc call "$@" 2>&1)"; then
        echo "the shell is not answering on config '$config_name'." >&2
        echo "start it, or check the name: qs -c $config_name" >&2
        return 1
    fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}

need_id() {
    if [ -z "${1:-}" ]; then
        echo "which one? give an id -- 'yukictl $2 list' shows them" >&2
        return 1
    fi
}

# The ids a shell's completion may offer, one per line, followed by a tab and
# what the registry says about that one. Taken from the same report a person
# reads, so a completion cannot offer a name the commands would then refuse.
#
# A row is a column of text meant for eyes: an id, a state, and whatever else
# that row has to say. Rows naming no id -- a directory turned away before it
# declared one -- have nothing to offer, and the state is what tells a row of
# the report apart from a line saying nothing is installed.
complete_ids() {
    local out
    out="$(qs -c "$config_name" ipc call "$1" list 2>/dev/null)" || return 0
    awk '$1 != "-" && $2 ~ /^(running|off|broken|pending|active|offered)$/ {
        id = $1
        $1 = ""
        sub(/^ +/, "")
        gsub(/  +/, " ")
        printf "%s\t%s\n", id, $0
    }' <<<"$out"
}

case "${1:-}" in
    plugins|plugin)
        case "${2:-list}" in
            list)    call plugins list ;;
            enable)  need_id "${3:-}" plugins && call plugins enable "$3" ;;
            disable) need_id "${3:-}" plugins && call plugins disable "$3" ;;
            *)       echo "unknown: plugins ${2}" >&2; usage >&2; exit 2 ;;
        esac
        ;;
    env|environments|environment)
        case "${2:-list}" in
            list) call environments list ;;
            use)  need_id "${3:-}" env && call environments use "$3" ;;
            *)    echo "unknown: env ${2}" >&2; usage >&2; exit 2 ;;
        esac
        ;;
    -h|--help|help|"")
        usage
        ;;
    # Undocumented on purpose: this answers a shell that is completing a word,
    # not a person. Silence when the shell is down, because a prompt is no
    # place to be told about it.
    __complete)
        case "${2:-}" in
            plugins) complete_ids plugins ;;
            env)     complete_ids environments ;;
        esac
        ;;
    *)
        echo "unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
