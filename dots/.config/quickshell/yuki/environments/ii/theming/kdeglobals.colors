; Colour groups for kdeglobals, generated from the wallpaper palette.
;
; Merged into ~/.config/kdeglobals rather than written over it: that file is
; read-write for every KDE application, which stores dialog geometry, sort
; order and fonts in it, so replacing it wholesale would throw those away.
;
; [WM] is deliberately absent. It colours KWin decorations, and nothing here
; runs KWin.
;
; ForegroundPositive is a literal because Material has no green role. It is the
; same value the GTK template uses for success, so both toolkits agree.

[Colors:Window]
BackgroundNormal={{colors.surface.default.hex}}
BackgroundAlternate={{colors.surface_variant.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundNormal={{colors.on_surface_variant.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

[Colors:View]
BackgroundNormal={{colors.surface_container_lowest.default.hex}}
BackgroundAlternate={{colors.surface.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary_container.default.hex}}
ForegroundNormal={{colors.on_surface.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

[Colors:Button]
BackgroundNormal={{colors.surface_container_high.default.hex}}
BackgroundAlternate={{colors.surface_variant.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundNormal={{colors.on_surface.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

[Colors:Selection]
BackgroundNormal={{colors.primary.default.hex}}
BackgroundAlternate={{colors.primary.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary_fixed_dim.default.hex}}
ForegroundNormal={{colors.on_primary.default.hex}}
ForegroundActive={{colors.on_primary.default.hex}}
ForegroundInactive={{colors.on_primary.default.hex}}
ForegroundLink={{colors.on_primary_container.default.hex}}
ForegroundVisited={{colors.on_primary_container.default.hex}}
ForegroundNegative={{colors.on_error_container.default.hex}}
ForegroundNeutral={{colors.on_secondary_container.default.hex}}
ForegroundPositive={{colors.on_primary.default.hex}}

[Colors:Tooltip]
BackgroundNormal={{colors.inverse_surface.default.hex}}
BackgroundAlternate={{colors.surface_variant.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundNormal={{colors.inverse_on_surface.default.hex}}
ForegroundActive={{colors.inverse_on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

[Colors:Complementary]
BackgroundNormal={{colors.surface.default.hex}}
BackgroundAlternate={{colors.surface_container_lowest.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundNormal={{colors.on_surface_variant.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

[Colors:Header]
BackgroundNormal={{colors.surface_container.default.hex}}
BackgroundAlternate={{colors.surface_container.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundNormal={{colors.on_surface_variant.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

[Colors:Header][Inactive]
BackgroundNormal={{colors.surface_container.default.hex}}
BackgroundAlternate={{colors.surface_container.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundNormal={{colors.on_surface_variant.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.outline.default.hex}}
ForegroundLink={{colors.tertiary.default.hex}}
ForegroundVisited={{colors.tertiary_fixed_dim.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.secondary.default.hex}}
ForegroundPositive=#B5CCBA

; Only the tint each effect uses. The strengths and which effect is on are the
; user's setting, so the groups are joined rather than replaced.
[ColorEffects:Disabled]
Color={{colors.surface.default.hex}}

[ColorEffects:Inactive]
Color={{colors.surface_container_lowest.default.hex}}
